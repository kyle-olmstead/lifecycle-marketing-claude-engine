{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyle-olmstead/lifecycle-marketing-claude-engine/schemas/experiment.schema.json",
  "title": "Experiment registry entry",
  "description": "One experiment in a workspace's registry (registry/experiments.json): how people are assigned, what is measured, the plan, the stopping rule and every look taken. engine/measurement/registry.py validates entries against this schema and adds the checks a schema cannot express (peeking, salt collisions, the readout floor).",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id", "flow", "unit", "assignment", "holdout_share", "primary_metric", "plan", "stopping_rule", "status", "looks_taken"],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$",
      "description": "stable id, lower case: letters, digits, underscore, dot, hyphen"
    },
    "flow": {"type": "string", "minLength": 1, "description": "the flow slug the experiment belongs to"},
    "unit": {"enum": ["user", "account", "household"], "description": "what is randomized; account and household randomize groups of people"},
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_field", "salt"],
      "properties": {
        "hash_field": {"enum": ["user_id", "account_id", "household_id"], "description": "the id that is hashed: it must match the unit"},
        "salt": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]+$", "description": "bucket = first 7 hex digits of md5(id || ':' || salt) mod 100"},
        "rule": {"type": "string", "description": "the assignment rule in words"}
      }
    },
    "holdout_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5, "description": "share of units in the holdout (bucket < share x 100)"},
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "disjoint_from": {"type": "array", "items": {"type": "string"}, "description": "experiment ids whose audiences cannot overlap this one; anything not listed is assumed to overlap"}
      }
    },
    "primary_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "window_days"],
      "properties": {
        "event": {"type": "string", "minLength": 1, "description": "the event (or core action) counted as a conversion"},
        "window_days": {"type": "integer", "minimum": 0, "description": "days each entrant is followed from entry"},
        "description": {"type": "string"}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "mde_abs", "n_per_arm", "read_on"],
      "properties": {
        "baseline": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1, "description": "conversion rate with no flow; null until known"},
        "mde_abs": {"type": ["number", "null"], "exclusiveMinimum": 0, "description": "smallest absolute difference worth acting on"},
        "n_per_arm": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["holdout", "treatment"],
          "properties": {
            "holdout": {"type": "integer", "minimum": 1},
            "treatment": {"type": "integer", "minimum": 1}
          }
        },
        "design_effect": {"type": "number", "minimum": 1, "description": "variance inflation from randomizing groups: 1 + ((1 + cv^2) x mean size - 1) x ICC"},
        "icc": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "mean_cluster_size": {"type": ["number", "null"], "minimum": 1},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "power": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "read_on": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "the planned read date; null when the plan cannot be computed yet"},
        "expected_read": {"type": "string"}
      }
    },
    "stopping_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design"],
      "properties": {
        "design": {"enum": ["fixed_horizon", "group_sequential", "always_valid"]},
        "looks": {"type": "integer", "minimum": 1},
        "information_fractions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        },
        "spending": {"enum": ["obf", "pocock"], "description": "Lan-DeMets spending function for group_sequential"},
        "sides": {"enum": [1, 2]},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "tau": {"type": "number", "exclusiveMinimum": 0, "description": "mixing spread of the mSPRT for always_valid: the absolute MDE"}
      },
      "allOf": [
        {
          "if": {"properties": {"design": {"const": "fixed_horizon"}}, "required": ["design"]},
          "then": {"required": ["looks"], "properties": {"looks": {"const": 1}, "information_fractions": {"const": [1]}}}
        },
        {
          "if": {"properties": {"design": {"const": "group_sequential"}}, "required": ["design"]},
          "then": {"required": ["looks", "information_fractions", "spending"], "properties": {"looks": {"minimum": 2}, "information_fractions": {"minItems": 2}}}
        },
        {
          "if": {"properties": {"design": {"const": "always_valid"}}, "required": ["design"]},
          "then": {"required": ["tau"]}
        }
      ]
    },
    "status": {"enum": ["draft", "running", "stopped", "completed", "abandoned"]},
    "launched_on": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "looks_taken": {"type": "array", "items": {"$ref": "#/$defs/look"}},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"unit": {"const": "user"}}, "required": ["unit"]},
      "then": {"properties": {"assignment": {"properties": {"hash_field": {"const": "user_id"}}}}}
    },
    {
      "if": {"properties": {"unit": {"const": "account"}}, "required": ["unit"]},
      "then": {
        "properties": {
          "assignment": {"properties": {"hash_field": {"const": "account_id"}}},
          "plan": {"required": ["design_effect"]}
        }
      }
    },
    {
      "if": {"properties": {"unit": {"const": "household"}}, "required": ["unit"]},
      "then": {
        "properties": {
          "assignment": {"properties": {"hash_field": {"const": "household_id"}}},
          "plan": {"required": ["design_effect"]}
        }
      }
    }
  ],
  "$defs": {
    "look": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "kind"],
      "properties": {
        "at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
        "kind": {"enum": ["primary", "guardrail_only"], "description": "primary: the primary metric was read; guardrail_only: sample ratio and guardrails only"},
        "information_fraction": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "n_holdout": {"type": "integer", "minimum": 0},
        "n_treatment": {"type": "integer", "minimum": 0},
        "conversions_holdout": {"type": "integer", "minimum": 0},
        "conversions_treatment": {"type": "integer", "minimum": 0},
        "z": {"type": ["number", "null"]},
        "boundary": {"type": ["number", "null"]},
        "p_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "confidence_sequence": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "decision": {"type": "string"},
        "counted": {"type": "boolean", "description": "false when the look fell below the readout floor and spent no alpha"},
        "note": {"type": "string"}
      }
    }
  }
}
