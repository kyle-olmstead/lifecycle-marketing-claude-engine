{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyle-olmstead/lifecycle-marketing-claude-engine/schemas/workspace.schema.json",
  "title": "LMM Engine workspace file (lmm.yaml)",
  "description": "Everything the engine remembers about one brand, in a file code reads (engine/workspace.py). Briefs planned in the workspace start from these values.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "frequency_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caps"
      ],
      "properties": {
        "caps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channels",
              "max",
              "window"
            ],
            "properties": {
              "channels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "email",
                    "sms",
                    "push",
                    "in_app"
                  ]
                }
              },
              "max": {
                "type": "integer",
                "minimum": 0
              },
              "window": {
                "type": "string",
                "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?)?$"
              }
            }
          }
        },
        "send_windows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channel",
              "allowed_from",
              "allowed_until"
            ],
            "properties": {
              "channel": {
                "enum": [
                  "email",
                  "sms",
                  "push",
                  "in_app"
                ]
              },
              "allowed_from": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "allowed_until": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "basis": {
                "const": "recipient_local"
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "flow_priority": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "collision_rule": {
          "enum": [
            "higher_priority_preempts",
            "queue_lower_priority",
            "drop_lower_priority"
          ]
        }
      }
    },
    "offer_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "offer_id",
              "kind"
            ],
            "properties": {
              "offer_id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "percent_off",
                  "amount_off",
                  "free_shipping",
                  "gift",
                  "credit",
                  "trial_extension"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "eligible": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stackable": {
                "type": "boolean"
              },
              "expires_after": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?)?$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "percent_off",
                        "amount_off"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "type": "number"
                    }
                  }
                }
              }
            ]
          }
        },
        "max_offers_per_person": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "window"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "window": {
              "type": "string",
              "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?)?$"
            }
          }
        },
        "min_days_between_offers": {
          "type": "integer",
          "minimum": 0
        },
        "never_in_first_touch": {
          "type": "boolean"
        },
        "exclude_if": {
          "type": "array",
          "items": {
            "enum": [
              "discount_share_over_50pct_last_3_orders",
              "redeemed_offer_last_30d",
              "segment_champions",
              "segment_cannot_lose"
            ]
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sending_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "assessed_at",
        "auth_label"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "GREEN",
            "AMBER",
            "RED"
          ]
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "auth_label": {
          "enum": [
            "LIVE PULL",
            "SUPPLIED",
            "UNKNOWN"
          ]
        },
        "domain": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "signals": {
          "type": "object",
          "properties": {
            "complaint_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hard_bounce_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "unengaged_share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "critical_findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "GREEN"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "auth_label": {
                "const": "LIVE PULL"
              },
              "critical_findings": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "business_model": {
          "enum": [
            "ecommerce",
            "subscription",
            "saas",
            "marketplace",
            "services",
            "sales_led_b2b"
          ]
        },
        "postal_address": {
          "type": [
            "string",
            "null"
          ]
        },
        "sender_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "brand_voice": {
          "type": [
            "string",
            "null"
          ]
        },
        "recipient_countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        }
      }
    },
    "brand_kit": {
      "type": [
        "string",
        "null"
      ],
      "description": "path to brand.yaml, relative to the workspace"
    },
    "platform": {
      "enum": [
        "klaviyo",
        "hubspot",
        "braze",
        "customerio",
        "iterable",
        "sfmc"
      ]
    },
    "esp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "object"
        }
      }
    },
    "warehouse_dialect": {
      "enum": [
        "postgres",
        "snowflake",
        "bigquery"
      ]
    },
    "sending_gate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "GREEN",
            "AMBER",
            "RED",
            "UNKNOWN"
          ]
        },
        {
          "type": "string",
          "pattern": "\\.json$",
          "description": "path to a gate record written by lcm deliverability"
        },
        {
          "$ref": "#/$defs/sending_gate"
        }
      ]
    },
    "frequency": {
      "$ref": "#/$defs/frequency_policy"
    },
    "offer_policy": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/offer_policy"
        }
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "randomization_unit": {
          "enum": [
            "user",
            "account"
          ]
        },
        "global_holdout_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "stopping_rule": {
          "enum": [
            "fixed_horizon",
            "group_sequential",
            "always_valid"
          ]
        }
      }
    },
    "data": {
      "type": [
        "string",
        "null"
      ],
      "description": "the data folder, relative to the workspace"
    }
  }
}
