{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyle-olmstead/lifecycle-marketing-claude-engine/schemas/event_envelope.schema.json",
  "title": "Event envelope",
  "description": "The event envelope every tracked event shares (a Segment-style track call), taken from config/tracking_plan.json Generated by engine/contracts.py.",
  "type": "object",
  "required": [
    "event",
    "event_id",
    "timestamp",
    "properties"
  ],
  "anyOf": [
    {
      "required": [
        "user_id"
      ],
      "properties": {
        "user_id": {
          "type": "string"
        }
      }
    },
    {
      "required": [
        "anonymous_id"
      ],
      "properties": {
        "anonymous_id": {
          "type": "string"
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "track"
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)+$",
      "description": "object_action in snake_case, past tense (config/tracking_plan.json lists the planned events)"
    },
    "event_id": {
      "type": "string",
      "minLength": 8,
      "description": "idempotency key: messageId in Segment and RudderStack, insert_id in Mixpanel and Amplitude"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "anonymous_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC, ISO 8601, when the action happened (not when it was received)"
    },
    "properties": {
      "type": "object"
    },
    "context": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "web",
            "ios",
            "android",
            "server",
            "warehouse"
          ]
        },
        "ip": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      }
    }
  }
}
