{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyle-olmstead/lifecycle-marketing-claude-engine/schemas/flow_spec.schema.json",
  "title": "LMM Engine flow specification",
  "description": "Machine-readable form of the FLOW block from the workflow-engineer method. A flow is defined by its exit conditions and suppression logic at least as much as by its content, so those fields are required. Every filter states whether it is evaluated at entry only or at every step: the most common build error on every platform. Branch targets are step ids or 'exit (...)', so the graph can be checked; waits may be in hours.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flow",
    "platform",
    "template_dialect",
    "lifecycle_stage",
    "objective",
    "clv_lever",
    "gate_required",
    "trigger",
    "entry_filters",
    "ongoing_filters",
    "suppressions",
    "holdout",
    "frequency",
    "steps",
    "exit",
    "measurement",
    "data_dependencies"
  ],
  "properties": {
    "flow": {
      "type": "string",
      "minLength": 3
    },
    "platform": {
      "enum": [
        "customerio",
        "braze",
        "klaviyo",
        "hubspot",
        "sfmc",
        "iterable",
        "other"
      ]
    },
    "analytics": {
      "type": "string"
    },
    "template_dialect": {
      "enum": [
        "customerio",
        "customerio_legacy",
        "braze",
        "klaviyo",
        "hubl",
        "ampscript",
        "handlebars",
        "liquid"
      ]
    },
    "lifecycle_stage": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "description": "the one behavior this flow changes"
    },
    "clv_lever": {
      "enum": [
        "acquisition",
        "transaction_value",
        "frequency",
        "lifespan"
      ],
      "description": "the CLV term the flow moves; acquisition is the first purchase or the first paid period"
    },
    "gate_required": {
      "enum": [
        "GREEN",
        "AMBER"
      ],
      "description": "minimum sending gate; AMBER means engaged-segment only"
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "definition",
        "source_object"
      ],
      "properties": {
        "type": {
          "enum": [
            "event",
            "state",
            "date",
            "score",
            "absence"
          ]
        },
        "definition": {
          "type": "string"
        },
        "source_object": {
          "type": "string"
        },
        "re_entry": {
          "oneOf": [
            {
              "type": "string",
              "description": "free text (hand-written specs); the teammate writes the object form"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "description"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "never",
                    "after_exit",
                    "cooldown"
                  ]
                },
                "cooldown": {
                  "type": "string",
                  "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?)?$"
                },
                "description": {
                  "type": "string"
                }
              },
              "if": {
                "properties": {
                  "mode": {
                    "const": "cooldown"
                  }
                }
              },
              "then": {
                "required": [
                  "cooldown"
                ]
              }
            }
          ]
        },
        "typed": {
          "$ref": "#/$defs/trigger",
          "description": "the typed trigger; identical to schemas/trigger.schema.json (tests/contracts checks they agree)"
        }
      }
    },
    "entry_filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/filter_entry"
      }
    },
    "ongoing_filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/filter_ongoing"
      }
    },
    "suppressions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      },
      "allOf": [
        {
          "contains": {
            "pattern": "(?i)unsubscribed"
          }
        },
        {
          "contains": {
            "pattern": "(?i)bounce"
          }
        }
      ]
    },
    "holdout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percent",
        "read"
      ],
      "properties": {
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "persistent": {
          "type": "boolean"
        },
        "unit": {
          "enum": [
            "user",
            "account"
          ]
        },
        "assignment": {
          "type": "string"
        },
        "sizing": {
          "type": "string"
        },
        "read": {
          "enum": [
            "causal",
            "causal, slow",
            "directional only",
            "not readable"
          ]
        },
        "reason_if_none": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "percent": {
            "exclusiveMinimum": 0
          }
        }
      },
      "then": {
        "required": [
          "persistent",
          "unit",
          "assignment",
          "sizing"
        ],
        "properties": {
          "persistent": {
            "const": true
          }
        }
      },
      "else": {
        "required": [
          "reason_if_none"
        ]
      }
    },
    "frequency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cap"
      ],
      "properties": {
        "cap": {
          "type": "string",
          "description": "the policy in words"
        },
        "caps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channels",
              "max",
              "window"
            ],
            "properties": {
              "channels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "email",
                    "sms",
                    "push",
                    "in_app"
                  ]
                }
              },
              "max": {
                "type": "integer",
                "minimum": 0
              },
              "window": {
                "type": "string",
                "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?)?$"
              }
            }
          }
        },
        "send_windows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channel",
              "allowed_from",
              "allowed_until"
            ],
            "properties": {
              "channel": {
                "enum": [
                  "email",
                  "sms",
                  "push",
                  "in_app"
                ]
              },
              "allowed_from": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "allowed_until": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "basis": {
                "const": "recipient_local"
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "send_hour_local": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "quiet_hours": {
          "type": "string",
          "description": "deprecated (v2): use send_windows, the permitted windows"
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "collision_rule": {
          "enum": [
            "higher_priority_preempts",
            "queue_lower_priority",
            "drop_lower_priority"
          ]
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "wait",
          "channel",
          "message",
          "goal"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "wait": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "none",
                  "fixed",
                  "until_event",
                  "until_time_local"
                ]
              },
              "duration": {
                "type": "string",
                "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?)?$",
                "description": "ISO 8601 duration, e.g. P1D, PT4H"
              },
              "event": {
                "type": "string"
              },
              "timeout": {
                "type": "string",
                "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?)?$"
              },
              "local_time": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "after": {
                "type": "string",
                "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?)?$",
                "description": "until_time_local: wait at least this long, then until the local time"
              }
            }
          },
          "condition": {
            "type": "string",
            "description": "evaluated before the step sends; native platform terms"
          },
          "channel": {
            "enum": [
              "email",
              "sms",
              "push",
              "in_app",
              "webhook",
              "internal_alert",
              "none"
            ]
          },
          "message": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "branch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition",
              "yes",
              "no"
            ],
            "properties": {
              "condition": {
                "type": "string"
              },
              "yes": {
                "type": "string",
                "pattern": "^([a-z0-9_]+|exit( \\(.+\\))?)$",
                "description": "a step id, or 'exit' with an optional reason in parentheses"
              },
              "no": {
                "type": "string",
                "pattern": "^([a-z0-9_]+|exit( \\(.+\\))?)$",
                "description": "a step id, or 'exit' with an optional reason in parentheses"
              }
            }
          },
          "respect_send_window": {
            "type": "boolean",
            "description": "hold the send to the channel's permitted window (flows timed in hours)"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "channel": {
                  "const": "sms"
                }
              }
            },
            "then": {
              "required": [
                "requires"
              ],
              "properties": {
                "requires": {
                  "contains": {
                    "const": "sms_consent"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "channel": {
                  "const": "push"
                }
              }
            },
            "then": {
              "required": [
                "requires"
              ],
              "properties": {
                "requires": {
                  "contains": {
                    "const": "push_permission"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "channel": {
                  "const": "email"
                }
              }
            },
            "then": {
              "required": [
                "requires"
              ],
              "properties": {
                "requires": {
                  "anyOf": [
                    {
                      "contains": {
                        "const": "email_consent"
                      }
                    },
                    {
                      "contains": {
                        "const": "transactional_basis"
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "wait": {
                  "properties": {
                    "type": {
                      "const": "until_event"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "wait": {
                  "required": [
                    "event",
                    "timeout"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "wait": {
                  "properties": {
                    "type": {
                      "const": "fixed"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "wait": {
                  "required": [
                    "duration"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "unenroll_immediately"
      ],
      "properties": {
        "goal": {
          "type": "string"
        },
        "unenroll_immediately": {
          "type": "boolean"
        },
        "then": {
          "type": "string"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_metric",
        "read_after",
        "compared_against"
      ],
      "properties": {
        "primary_metric": {
          "type": "string"
        },
        "read_after": {
          "type": "string"
        },
        "compared_against": {
          "enum": [
            "holdout",
            "pre_post_baseline",
            "none"
          ]
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "data_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "event",
              "attribute",
              "object"
            ]
          },
          "status": {
            "enum": [
              "verified",
              "blocked",
              "unknown"
            ]
          },
          "fill_rate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "flow_type": {
      "enum": [
        "welcome",
        "activation",
        "winback",
        "cart_abandon",
        "browse_abandon",
        "post_purchase",
        "replenishment",
        "dunning",
        "trial_convert",
        "sunset",
        "other"
      ],
      "description": "the flow library entry it was planned from (engine/flows/library.py); 'other' for hand-written specs"
    },
    "message_class": {
      "enum": [
        "marketing",
        "transactional"
      ],
      "description": "transactional flows (billing notices) do not depend on marketing consent and carry no marketing content"
    }
  },
  "$defs": {
    "filter_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "evaluated"
      ],
      "properties": {
        "condition": {
          "type": "string"
        },
        "evaluated": {
          "const": "entry_only"
        }
      }
    },
    "filter_ongoing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "evaluated"
      ],
      "properties": {
        "condition": {
          "type": "string"
        },
        "evaluated": {
          "const": "every_step"
        }
      }
    },
    "event_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event"
      ],
      "properties": {
        "event": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "where": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "trigger": {
      "title": "Flow trigger with hour-level waits and structured re-entry",
      "description": "How a person enters a flow (engine/policy/contracts.TriggerDefinition). Durations are ISO 8601 in days, hours or minutes, so a 2-hour browse abandonment is abandon_after PT2H.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "type",
        "re_entry",
        "dedupe_key"
      ],
      "properties": {
        "flow_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "type": {
          "enum": [
            "event",
            "absence",
            "state_change",
            "schedule"
          ]
        },
        "event": {
          "$ref": "#/$defs/event_ref"
        },
        "absence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anchor",
            "missing",
            "after"
          ],
          "properties": {
            "anchor": {
              "$ref": "#/$defs/event_ref"
            },
            "missing": {
              "$ref": "#/$defs/event_ref"
            },
            "after": {
              "type": "string",
              "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?)?$"
            }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object",
            "field",
            "to"
          ],
          "properties": {
            "object": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "offset": {
              "type": "string"
            },
            "relative_to": {
              "type": "string"
            }
          }
        },
        "schedule": {
          "type": "string"
        },
        "abandon_after": {
          "type": "string",
          "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?)?$"
        },
        "exclude_if": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_ref"
          }
        },
        "re_entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "never",
                "after_exit",
                "cooldown"
              ]
            },
            "cooldown": {
              "type": "string",
              "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?)?$"
            }
          },
          "if": {
            "properties": {
              "mode": {
                "const": "cooldown"
              }
            }
          },
          "then": {
            "required": [
              "cooldown"
            ]
          }
        },
        "dedupe_key": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "esp_native",
            "warehouse_job",
            "stream"
          ]
        },
        "holdout_experiment_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "event"
              }
            }
          },
          "then": {
            "required": [
              "event"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "absence"
              }
            }
          },
          "then": {
            "required": [
              "absence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "state_change"
              }
            }
          },
          "then": {
            "required": [
              "state"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "schedule"
              }
            }
          },
          "then": {
            "required": [
              "schedule"
            ]
          }
        }
      ]
    }
  }
}
