<!--
  Headline: one h1, so screen readers announce the email's subject matter first. The color comes from the
  mj-text default (the kit's text color) and is switched in dark mode by the .lcm-text rules in base.mjml.
  Placeholders: [[font_family]] [[headline]]
-->
        <mj-text css-class="lcm-text">
          <h1 style="margin:0;font-family:[[font_family]];font-size:22px;line-height:1.3;font-weight:bold;">[[headline]]</h1>
        </mj-text>
