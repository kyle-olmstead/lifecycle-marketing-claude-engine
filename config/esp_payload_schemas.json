{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyle-olmstead/lifecycle-marketing-claude-engine/config/esp_payload_schemas.json",
  "title": "LMM Engine ESP trigger-event request bodies",
  "description": "Request bodies the engine builds for ESPs: one custom event per flow entrant (adapters/destinations/event_payloads.py, checked by engine/policy/simulator.py --payloads) and person-attribute updates (adapters/destinations/payloads.py attribute_sync, used by engine/agents/engagement.py). One $defs entry per endpoint; x-endpoint records the method, URL, authentication, limits and the documentation each was read from",
  "type": "object",
  "$defs": {
    "klaviyo_create_event": {
      "x-endpoint": {
        "method": "POST",
        "url": "https://a.klaviyo.com/api/events",
        "headers": {
          "Authorization": "Klaviyo-API-Key <private key>",
          "revision": "2026-10-15",
          "Content-Type": "application/vnd.api+json"
        },
        "scope": "events:write",
        "idempotency": "attributes.unique_id",
        "bulk": "POST https://a.klaviyo.com/api/event-bulk-create-jobs (data.type event-bulk-create-job): up to 1,000 events, 5 MB per request; a repeated unique_id rejects the whole request",
        "docs": [
          "https://developers.klaviyo.com/en/reference/create_event",
          "https://developers.klaviyo.com/en/reference/bulk_create_events"
        ],
        "checked": "2026-10-20"
      },
      "type": "object",
      "required": [
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "type",
            "attributes"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "event"
            },
            "attributes": {
              "type": "object",
              "required": [
                "properties",
                "metric",
                "profile"
              ],
              "additionalProperties": false,
              "properties": {
                "properties": {
                  "type": "object"
                },
                "time": {
                  "type": "string",
                  "format": "date-time"
                },
                "value": {
                  "type": "number"
                },
                "value_currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "unique_id": {
                  "type": "string",
                  "minLength": 1
                },
                "metric": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "type",
                        "attributes"
                      ],
                      "properties": {
                        "type": {
                          "const": "metric"
                        },
                        "attributes": {
                          "type": "object",
                          "required": [
                            "name"
                          ],
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "profile": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "type",
                        "attributes"
                      ],
                      "properties": {
                        "type": {
                          "const": "profile"
                        },
                        "attributes": {
                          "type": "object",
                          "properties": {
                            "email": {
                              "type": "string",
                              "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
                            },
                            "phone_number": {
                              "type": "string"
                            },
                            "external_id": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "anyOf": [
                            {
                              "required": [
                                "email"
                              ]
                            },
                            {
                              "required": [
                                "phone_number"
                              ]
                            },
                            {
                              "required": [
                                "external_id"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "hubspot_send_events": {
      "x-endpoint": {
        "method": "POST",
        "url": "https://api.hubapi.com/events/2026-09/send",
        "headers": {
          "Authorization": "Bearer <private app token>"
        },
        "scope": "analytics.behavioral_events.send",
        "success": "204 No Content",
        "versioning": "date-versioned since 2026: new versions each March and September, current for 6 months, unsupported 18 months after release; /events/v3/send is still documented as legacy with no announced sunset",
        "docs": [
          "https://developers.hubspot.com/docs/api-reference/latest/events/send-event-data/guide",
          "https://developers.hubspot.com/docs/developer-tooling/platform/versioning"
        ],
        "checked": "2026-10-20"
      },
      "type": "object",
      "required": [
        "eventName",
        "properties"
      ],
      "additionalProperties": false,
      "properties": {
        "eventName": {
          "type": "string",
          "pattern": "^pe\\d+_[a-z0-9_]+$",
          "description": "pe<hub id>_<event internal name>"
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "objectId": {
          "type": "string"
        },
        "utk": {
          "type": "string"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "uuid": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "email"
          ]
        },
        {
          "required": [
            "objectId"
          ]
        },
        {
          "required": [
            "utk"
          ]
        }
      ]
    },
    "hubspot_send_events_batch": {
      "x-endpoint": {
        "method": "POST",
        "url": "https://api.hubapi.com/events/2026-09/send/batch",
        "limits": "up to 500 inputs per request",
        "docs": [
          "https://developers.hubspot.com/docs/api-reference/latest/events/send-event-data/guide"
        ],
        "checked": "2026-10-20"
      },
      "type": "object",
      "required": [
        "inputs"
      ],
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/hubspot_send_events"
          }
        }
      }
    },
    "braze_users_track": {
      "x-endpoint": {
        "method": "POST",
        "url": "https://rest.<instance>.braze.com/users/track",
        "headers": {
          "Authorization": "Bearer <REST API key with users.track>"
        },
        "limits": "75 objects per request in total across attributes, events and purchases; nested event properties up to 100 KB; time and event_name are reserved property keys",
        "docs": [
          "https://www.braze.com/docs/api/endpoints/user_data/post_user_track/",
          "https://www.braze.com/docs/api/objects_filters/event_object/"
        ],
        "checked": "2026-10-20"
      },
      "type": "object",
      "anyOf": [
        {
          "required": [
            "events"
          ]
        },
        {
          "required": [
            "attributes"
          ]
        },
        {
          "required": [
            "purchases"
          ]
        }
      ],
      "properties": {
        "events": {
          "type": "array",
          "maxItems": 75,
          "items": {
            "type": "object",
            "required": [
              "name",
              "time"
            ],
            "properties": {
              "external_id": {
                "type": "string",
                "minLength": 1
              },
              "user_alias": {
                "type": "object"
              },
              "braze_id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "app_id": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "time": {
                "type": "string",
                "format": "date-time"
              },
              "properties": {
                "type": "object",
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "time"
                      ]
                    },
                    {
                      "required": [
                        "event_name"
                      ]
                    }
                  ]
                }
              },
              "_update_existing_only": {
                "type": "boolean"
              }
            },
            "oneOf": [
              {
                "required": [
                  "external_id"
                ]
              },
              {
                "required": [
                  "user_alias"
                ]
              },
              {
                "required": [
                  "braze_id"
                ]
              },
              {
                "required": [
                  "email"
                ]
              },
              {
                "required": [
                  "phone"
                ]
              }
            ]
          }
        },
        "attributes": {
          "type": "array",
          "maxItems": 75,
          "items": {
            "type": "object",
            "properties": {
              "external_id": {
                "type": "string",
                "minLength": 1
              },
              "user_alias": {
                "type": "object"
              },
              "braze_id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "_update_existing_only": {
                "type": "boolean"
              }
            },
            "anyOf": [
              {
                "required": [
                  "external_id"
                ]
              },
              {
                "required": [
                  "user_alias"
                ]
              },
              {
                "required": [
                  "braze_id"
                ]
              },
              {
                "required": [
                  "email"
                ]
              },
              {
                "required": [
                  "phone"
                ]
              }
            ]
          }
        },
        "purchases": {
          "type": "array",
          "maxItems": 75
        }
      }
    },
    "customerio_pipelines_track": {
      "x-endpoint": {
        "method": "POST",
        "url": "https://cdp.customer.io/v1/track (EU: https://cdp-eu.customer.io/v1/track)",
        "headers": {
          "Authorization": "Basic base64(<pipelines API key>:)"
        },
        "recommended": "Customer.io recommends the Pipelines API over the Track API v1",
        "limits": "500 KB per request and 32 KB per call (batch endpoint documentation); the engine packs batches to 450,000 bytes and calls to 30,000",
        "idempotency": "messageId",
        "docs": [
          "https://docs.customer.io/integrations/api/cdp/",
          "https://docs.customer.io/integrations/data-in/connections/http-api.md",
          "https://docs.customer.io/integrations/api/cdp/tag/default/batch/"
        ],
        "checked": "2026-10-20"
      },
      "type": "object",
      "required": [
        "event"
      ],
      "anyOf": [
        {
          "required": [
            "userId"
          ]
        },
        {
          "required": [
            "anonymousId"
          ]
        }
      ],
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "anonymousId": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "object"
        }
      }
    },
    "customerio_track_v1": {
      "x-endpoint": {
        "method": "POST",
        "url": "https://track.customer.io/api/v1/customers/{identifier}/events (EU: track-eu.customer.io)",
        "headers": {
          "Authorization": "Basic base64(<site id>:<API key>)"
        },
        "identifier": "id, email or cio_id (not phone)",
        "limits": "event name up to 100 bytes; data up to 100,000 bytes",
        "idempotency": "id (a ULID)",
        "docs": [
          "https://docs.customer.io/integrations/api/track/"
        ],
        "checked": "2026-10-20"
      },
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "data": {
          "type": "object"
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "type": {
          "const": "event"
        }
      }
    },
    "klaviyo_profile_bulk_import": {
      "x-endpoint": {
        "method": "POST",
        "url": "https://a.klaviyo.com/api/profile-bulk-import-jobs",
        "headers": {
          "Authorization": "Klaviyo-API-Key <private key with profiles:write>",
          "revision": "2026-10-15"
        },
        "limits": "10,000 profiles and 5 MB per job, 100 KB per profile; null values do not clear a property through this endpoint",
        "docs": [
          "https://developers.klaviyo.com/en/reference/bulk_import_profiles"
        ],
        "checked": "2026-10-20"
      },
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "type",
            "attributes"
          ],
          "properties": {
            "type": {
              "const": "profile-bulk-import-job"
            },
            "attributes": {
              "type": "object",
              "required": [
                "profiles"
              ],
              "properties": {
                "profiles": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 10000,
                      "items": {
                        "type": "object",
                        "required": [
                          "type",
                          "attributes"
                        ],
                        "properties": {
                          "type": {
                            "const": "profile"
                          },
                          "attributes": {
                            "type": "object",
                            "anyOf": [
                              {
                                "required": [
                                  "email"
                                ]
                              },
                              {
                                "required": [
                                  "phone_number"
                                ]
                              },
                              {
                                "required": [
                                  "external_id"
                                ]
                              }
                            ],
                            "properties": {
                              "email": {
                                "type": "string"
                              },
                              "phone_number": {
                                "type": "string"
                              },
                              "external_id": {
                                "type": "string"
                              },
                              "properties": {
                                "type": "object"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "relationships": {
              "type": "object"
            }
          }
        }
      }
    },
    "hubspot_contacts_batch_upsert": {
      "x-endpoint": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/objects/2026-09/contacts/batch/upsert",
        "headers": {
          "Authorization": "Bearer <private app token with crm.objects.contacts.write>"
        },
        "limits": "100 inputs per request; property internal names must exist on the contact object; values are strings",
        "docs": [
          "https://developers.hubspot.com/docs/api-reference/crm-contacts-v3/batch/post-crm-v3-objects-contacts-batch-upsert"
        ],
        "checked": "2026-10-20"
      },
      "type": "object",
      "required": [
        "inputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "id",
              "properties"
            ],
            "properties": {
              "idProperty": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "properties": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "customerio_pipelines_batch": {
      "x-endpoint": {
        "method": "POST",
        "url": "https://cdp.customer.io/v1/batch (EU: https://cdp-eu.customer.io/v1/batch)",
        "headers": {
          "Authorization": "Basic base64(<pipelines API key>:)"
        },
        "limits": "500 KB per request and 32 KB per call (batch endpoint documentation); the engine packs batches to 450,000 bytes and calls to 30,000",
        "docs": [
          "https://docs.customer.io/integrations/api/cdp/",
          "https://docs.customer.io/integrations/data-in/connections/http-api.md",
          "https://docs.customer.io/integrations/api/cdp/tag/default/batch/"
        ],
        "checked": "2026-10-20"
      },
      "type": "object",
      "required": [
        "batch"
      ],
      "properties": {
        "batch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "identify",
                  "track",
                  "page",
                  "screen",
                  "group",
                  "alias"
                ]
              },
              "userId": {
                "type": "string",
                "minLength": 1
              },
              "anonymousId": {
                "type": "string"
              },
              "traits": {
                "type": "object"
              },
              "event": {
                "type": "string"
              },
              "properties": {
                "type": "object"
              },
              "messageId": {
                "type": "string"
              }
            },
            "anyOf": [
              {
                "required": [
                  "userId"
                ]
              },
              {
                "required": [
                  "anonymousId"
                ]
              }
            ]
          }
        }
      }
    },
    "iterable_track_event": {
      "x-endpoint": {
        "method": "POST",
        "url": "https://api.iterable.com/api/events/track",
        "headers": {
          "Api-Key": "<project API key>",
          "Content-Type": "application/json"
        },
        "idempotency": "id: an event that repeats an id updates the existing event (an upsert), so retries never add a second event",
        "limits": "rate limits are per project for this endpoint; 429 on the limit, retry with exponential backoff; allow 60 seconds between updates to the same user before relying on them",
        "confidence": {
          "endpoint": "VERIFIED",
          "rate_and_retry": "VERIFIED",
          "body_field_names": "LIKELY (API mirror)",
          "id_upsert": "LIKELY (API mirror)",
          "Api-Key_header": "LIKELY (keys in the query string or body face stricter limits since 2025-11-10, so the header is used)"
        },
        "docs": [
          "https://support.iterable.com/hc/en-us/articles/41044692130196-Getting-Started-with-Iterable-s-API",
          "https://www.withone.ai/knowledge/iterable/conn_mod_def%3A%3AGMpa_AAb4JM%3A%3AFyDNEPtOQXemxSpKtQdOrg"
        ],
        "checked": "2026-10-21"
      },
      "type": "object",
      "required": [
        "eventName"
      ],
      "anyOf": [
        {
          "required": [
            "email"
          ]
        },
        {
          "required": [
            "userId"
          ]
        }
      ],
      "additionalProperties": false,
      "properties": {
        "eventName": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 3
        },
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "dataFields": {
          "type": "object"
        },
        "campaignId": {
          "type": "integer"
        },
        "templateId": {
          "type": "integer"
        }
      }
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/klaviyo_create_event"
    },
    {
      "$ref": "#/$defs/hubspot_send_events"
    },
    {
      "$ref": "#/$defs/hubspot_send_events_batch"
    },
    {
      "$ref": "#/$defs/braze_users_track"
    },
    {
      "$ref": "#/$defs/customerio_pipelines_track"
    },
    {
      "$ref": "#/$defs/customerio_track_v1"
    },
    {
      "$ref": "#/$defs/klaviyo_profile_bulk_import"
    },
    {
      "$ref": "#/$defs/hubspot_contacts_batch_upsert"
    },
    {
      "$ref": "#/$defs/customerio_pipelines_batch"
    },
    {
      "$ref": "#/$defs/iterable_track_event"
    }
  ]
}
