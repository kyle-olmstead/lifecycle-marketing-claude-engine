</mj-raw>
  <mj-head>
    <mj-title>This week&#x27;s numbers are ready to pull</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-section padding="0" />
      <mj-text color="#1F2933" font-size="16px" line-height="1.5" padding="0 24px 16px 24px" />
      <mj-image padding="0 24px" />
    </mj-attributes>
    <mj-raw>
      <meta name="color-scheme" content="light dark">
      <meta name="supported-color-schemes" content="light dark">
      <meta name="x-apple-disable-message-reformatting">
    </mj-raw>
    <mj-style>
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      a { color: #2B4C7E; }
      @media (prefers-color-scheme: dark) {
        body, .lcm-body { background-color: #10161F !important; }
        .lcm-card, .lcm-card > table { background: #18212D !important; background-color: #18212D !important; }
        .lcm-footer, .lcm-footer > table { background: #10161F !important; background-color: #10161F !important; }
