een and (min-width:480px) {\n          .mj-column-per-100 { width:100% !important; max-width: 100%; }\n      }\n    </style>\n    <style media=\"screen and (min-width:480px)\">\n        .moz-text-html .mj-column-per-100 { width:100% !important; max-width: 100%; }\n    </style>\n    \n    <style type=\"text/css\">\n      @media only screen and (max-width:479px) {\n              table.mj-full-width-mobile { width: 100% !important; }\n              td.mj-full-width-mobile { width: auto !important; }\n            }\n    </style>\n    <style type=\"text/css\">:root { color-scheme: light dark; supported-color-schemes: light dark; }\n      a { color: #6B3E26; }\n      @media (prefers-color-scheme: dark) {\n        body, .lcm-body { background-color: #15100C !important; }\n        .lcm-card, .lcm-card > table { background: #211913 !important; background-color: #211913 !important; }\n        .lcm-footer, .lcm-footer > table { background: #15100C !important; background-color: #15100C !important; }\n        .lcm-text div, .lcm-text h1 { color: #F3ECE4 !important; }\n        a { color: #E0A878 !important; }\n        .lcm-button td, .lcm-button a { background: #D9A066 !important; background-color: #D9A066 !important; }\n        .lcm-button a { color: #1A120C !important; }\n      }\n      [data-ogsc] .lcm-text div, [data-ogsc] .lcm-text h1 { color: #F3ECE4 !important; }\n      [data-ogsc] a { color: #E0A878 !important; }\n      [data-ogsc] .lcm-button a { color: #1A120C !important; }\n      [data-ogsb] .lcm-body { background-color: #15100C !important; }\n      [data-ogsb] .lcm-card, [data-ogsb] .lcm-card > table { background-color: #211913 !important; }\n      [data-ogsb] .lcm-footer, [data-ogsb] .lcm-footer > table { background-color: #15100C !important; }\n      [data-ogsb] .lcm-button td, [data-ogsb] .lcm-button a { background-color: #D9A066 !important; }</style>\n    \n\n\n<meta content=\"light dark\" name=\"color-scheme\"/>\n<meta content=\"light dark\" name=\"supported-color-schemes\"/>\n<meta name=\"x-apple-disable-message-reformatting\"/>\n<!--[if mso]><style type=\"text/css\">body, table, td, div, p, a, h1 { font-family: Georgia, 'Times New Roman', serif !important; }</style><![endif]-->\n\n  </head>\n  <body style=\"word-spacing:normal;background-color:#F6F1EA;\">\n    \n    <div aria-roledescription=\"email\" class=\"lcm-body\" style=\"background-color:#F6F1EA\" role=\"article\" lang=\"en-US\" dir=\"auto\" aria-label=\"Which grind should you choose?\"><div class=\"preheader\" style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">Tell us how you brew and we will tell you&#8204;&#160;&#8204;&#160;&#8204;&#160;&#8204;&#160;&#8204;&#160;&#8204;&#160;&#8204;&#160;&#8204;&#160;&#8204;&#160;&#8204;&#160;&#8204;&#160;&#8204;&#160;&#8204;&#160;&#8204;&#160;&#8204;&#160;&#8204;&#160;</div>\n            <!--[if mso | IE]>\n            <table\n              align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"lcm-card-outlook\" role=\"presentation\" style=\"width:600px\" width=\"600\" bgcolor=\"#FFFFFF\"\n            >\n              <tr>\n                <td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\">\n            <![endif]-->\n        <div class=\"lcm-card\" style=\"background:#FFFFFF;background-color:#FFFFFF;margin:0px auto;max-width:600px\">\n        \n        <table\n          align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;background:#FFFFFF;background-color:#FFFFFF\"\n        >\n          <tbody>\n            <tr>\n              <td\n                style=\"direction:ltr;font-size:0px;padding:24px 0 0 0;text-align:center\"\n              >\n                <!--[if mso | IE]>\n                  <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n                \n              <tr>\n            \n                <td style=\"vertical-align:top;width:600px\">\n              <![endif]-->\n                <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%\">\n                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"vertical-align:top\" width=\"100%\">\n            <tbody>\n                <tr>\n              <td align=\"left\" style=\"font-size:0px;padding:0 24px;word-break:break-word\">\n                \n          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:collapse;border-spacing:0px\" >\n            <tbody>\n              <tr>\n                <td style=\"width:160px\" >\n                  \n                <a href=\"https://www.northfieldcoffee.example\" target=\"_blank\">\n                  <img alt=\"Northfield Coffee Roasters\" height=\"40\" src=\"https://www.northfieldcoffee.example/email/northfield-wordmark-320x80.png\" style=\"border:0;display:block;outline:none;text-decoration:none;height:40px;width:100%;font-size:13px\" width=\"160\" />\n                </a>\n            \n                </td>\n              </tr>\n            </tbody>\n          </table>\n              </td>\n            </tr>\n            </tbody>\n        </table>\n            </div>\n              <!--[if mso | IE]>\n                </td>\n              \n              </tr>\n            \n                  </table>\n                <![endif]-->\n              </td>\n            </tr>\n          </tbody>\n        </table>\n        \n      </div>\n            <!--[if mso | IE]>\n                </td>\n              </tr>\n            </table>\n            \n            <table\n              align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"lcm-card-outlook\" role=\"presentation\" style=\"width:600px\" width=\"600\" bgcolor=\"#FFFFFF\"\n            >\n              <tr>\n                <td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\">\n            <![endif]-->\n        <div class=\"lcm-card\" style=\"background:#FFFFFF;background-color:#FFFFFF;margin:0px auto;max-width:600px\">\n        \n        <table\n          align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;background:#FFFFFF;background-color:#FFFFFF\"\n        >\n          <tbody>\n            <tr>\n              <td\n                style=\"direction:ltr;font-size:0px;padding:16px 0 0 0;text-align:center\"\n              >\n                <!--[if mso | IE]>\n                  <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n                \n              <tr>\n            \n                <td style=\"vertical-align:top;width:600px\">\n              <![endif]-->\n                <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%\">\n                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"vertical-align:top\" width=\"100%\">\n            <tbody>\n                <tr>\n              <td align=\"left\" class=\"lcm-text\" style=\"font-size:0px;padding:0 24px 16px 24px;word-break:break-word\">\n                <div style=\"font-family:Lora, Georgia, 'Times New Roman', serif;font-size:16px;line-height:1.5;text-align:left;color:#2B2118\"><h1 style=\"margin:0;font-family:Lora, Georgia, 'Times New Roman', serif;font-size:22px;line-height:1.3;font-weight:bold;\">The right grind for how you brew</h1></div>\n              </td>\n            </tr><tr>\n              <td align=\"left\" class=\"lcm-text\" style=\"font-size:0px;padding:0 24px 16px 24px;word-break:break-word\">\n                <div style=\"font-family:Lora, Georgia, 'Times New Roman', serif;font-size:16px;line-height:1.5;text-align:left;color:#2B2118\">Hi {{ first_name|default:'there' }}, the question we hear most at checkout is which grind to choose. Whole bean keeps longest if you have a grinder; otherwise pick the grind for your brewer: coarse for a French press, medium for drip, fine for espresso.</div>\n              </td>\n            </tr><tr>\n              <td align=\"left\" class=\"lcm-text\" style=\"font-size:0px;padding:0 24px 16px 24px;word-break:break-word\">\n                <div style=\"font-family:Lora, Georgia, 'Times New Roman', serif;font-size:16px;line-height:1.5;text-align:left;color:#2B2118\">Not sure? Reply with how you make your coffee and a person on our team will tell you which to pick. Your cart is saved in the meantime.</div>\n              </td>\n            </tr>\n            </tbody>\n        </table>\n            </div>\n              <!--[if mso | IE]>\n                </td>\n              \n              </tr>\n            \n                  </table>\n                <![endif]-->\n              </td>\n            </tr>\n          </tbody>\n        </table>\n        \n      </div>\n            <!--[if mso | IE]>\n                </td>\n              </tr>\n            </table>\n            \n            <table\n              align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"lcm-card-outlook\" role=\"presentation\" style=\"width:600px\" width=\"600\" bgcolor=\"#FFFFFF\"\n            >\n              <tr>\n                <td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\">\n            <![endif]-->\n        <div class=\"lcm-card\" style=\"background:#FFFFFF;background-color:#FFFFFF;margin:0px auto;max-width:600px\">\n        \n        <table\n          align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;background:#FFFFFF;background-color:#FFFFFF\"\n        >\n          <tbody>\n            <tr>\n              <td\n                style=\"direction:ltr;font-size:0px;padding:0 0 32px 0;text-align:center\"\n              >\n                <!--[if mso | IE]>\n                  <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n                \n              <tr>\n            \n                <td style=\"vertical-align:top;width:600px\">\n              <![endif]-->\n                <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%\">\n                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"vertical-align:top\" width=\"100%\">\n            <tbody>\n                <tr>\n              <td align=\"left\" class=\"lcm-button\" style=\"font-size:0px;padding:8px 24px 0 24px;word-break:break-word\">\n                \n            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:separate;line-height:100%\" >\n              <tr>\n                <td align=\"center\" bgcolor=\"#6B3E26\" role=\"presentation\" style=\"border:none;border-radius:6px;cursor:auto;mso-padding-alt:12px 20px;background:#6B3E26\" valign=\"middle\" >\n                  <a href=\"{{ event.extra.checkout_url|default:organization.url }}\" style=\"display:inline-block;background:#6B3E26;color:#FFFFFF;font-family:Lora, Georgia, 'Times New Roman', serif;font-size:16px;font-weight:bold;line-height:1.25;margin:0;text-decoration:none;text-transform:none;padding:12px 20px;mso-padding-alt:0px;border-radius:6px\" target=\"_blank\" >\n                    Back to my cart\n                  </a>\n                </td>\n              </tr>\n            </table>\n        \n              </td>\n            </tr>\n            </tbody>\n        </table>\n            </div>\n              <!--[if mso | IE]>\n                </td>\n              \n              </tr>\n            \n                  </table>\n                <![endif]-->\n              </td>\n            </tr>\n          </tbody>\n        </table>\n        \n      </div>\n            <!--[if mso | IE]>\n                </td>\n              </tr>\n            </table>\n            \n            <table\n              align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"lcm-footer-outlook\" role=\"presentation\" style=\"width:600px\" width=\"600\" bgcolor=\"#F6F1EA\"\n            >\n              <tr>\n                <td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\">\n            <![endif]-->\n        <div class=\"lcm-footer\" style=\"background:#F6F1EA;background-color:#F6F1EA;margin:0px auto;max-width:600px\">\n        \n        <table\n          align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;background:#F6F1EA;background-color:#F6F1EA\"\n        >\n          <tbody>\n            <tr>\n              <td\n                style=\"direction:ltr;font-size:0px;padding:16px 0 24px 0;text-align:center\"\n              >\n                <!--[if mso | IE]>\n                  <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n                \n              <tr>\n            \n                <td style=\"vertical-align:top;width:600px\">\n              <![endif]-->\n                <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%\">\n                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"vertical-align:top\" width=\"100%\">\n            <tbody>\n                <tr>\n              <td align=\"left\" class=\"lcm-text\" style=\"font-size:0px;padding:0 24px;word-break:break-word\">\n                <div style=\"font-family:Lora, Georgia, 'Times New Roman', serif;font-size:12px;line-height:1.5;text-align:left;color:#2B2118\">Sam at Northfield<br/>\n          {{ organization.name }}, {{ organization.full_address }}<br/>\n          You are getting this because you bought from us or joined the roast list.<br/>\n          Questions about an order? Reply to this email and a person on our team will answer.<br/>\n<a href=\"https://www.instagram.example/northfieldcoffee\">Instagram</a> | <a href=\"https://www.northfieldcoffee.example/brew\">Brew guides</a><br/>\n          {% unsubscribe 'Unsubscribe' %}</div>\n              </td>\n            </tr>\n            </tbody>\n        </table>\n            </div>\n              <!--[if mso | IE]>\n                </td>\n              \n              </tr>\n            \n                  </table>\n                <![endif]-->\n              </td>\n            </tr>\n          </tbody>\n        </table>\n        \n      </div>\n            <!--[if mso | IE]>\n                </td>\n              </tr>\n            </table>\n            <![endif]--></div>\n  </body>\n</html>",
        "text": "The right grind for how you brew\n\nHi {{ first_name|default:'there' }}, the question we hear most at checkout is which grind to choose. Whole bean keeps longest if you have a grinder; otherwise pick the grind for your brewer: coarse for a French press, medium for drip, fine for espresso.\n\nNot sure? Reply with how you make your coffee and a person on our team will tell you which to pick. Your cart is saved in the meantime.\n\nBack to my cart: {{ event.extra.checkout_url|default:organization.url }}\n\nSam at Northfield\n{{ organization.name }}, {{ organization.full_address }}\nYou are getting this because you bought from us or joined the roast list.\nQuestions about an order? Reply to this email and a person on our team will answer.\nInstagram: https://www.instagram.example/northfieldcoffee\nBrew guides: https://www.northfieldcoffee.example/brew\nUnsubscribe: {% unsubscribe_link %}\n"
      }
