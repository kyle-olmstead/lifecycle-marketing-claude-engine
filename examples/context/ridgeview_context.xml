<?xml version="1.0" encoding="UTF-8"?>
<!--
  Filled example of core/context_loader.xml for a fictional company. Every name, domain and number
  is invented; domains use the RFC 2606 reserved names. The tables match tests/fixtures, so every
  module's worked example can be reproduced against this context.
-->
<lmm_context version="2.0.0">

  <organization>
    <brand_name required="true" label="SUPPLIED">Ridgeview</brand_name>
    <legal_name required="true" label="SUPPLIED">Ridgeview Analytics, Inc. (fictional)</legal_name>
    <postal_address required="true" label="SUPPLIED">100 Example Way, Suite 400, Springfield, OR 97477</postal_address>
    <industry label="SUPPLIED">B2B software: reporting for operations teams</industry>
    <business_model required="true" label="SUPPLIED">subscription</business_model>
    <transaction_object required="true" label="LIVE PULL" observed_at="2026-10-19">orders, status = completed, net_amount > 0 (one row per paid order or subscription charge)</transaction_object>
    <customer_definition required="true" label="SUPPLIED">a user with at least one completed order</customer_definition>
    <buying_unit label="SUPPLIED">account (workspace)</buying_unit>
    <recipient_geography label="ESTIMATE">US 44%, UK 14%, Canada 14%, Australia 14%, Germany 14% (from users.country on the fixtures)</recipient_geography>
  </organization>

  <voice_module label="ESTIMATE">
    <sender_identities>
      <sender role="marketing" from_name="Ridgeview" from_address="news@example.com" reply_to="support@example.com"/>
      <sender role="person" from_name="Dana Ortiz" from_address="dana@example.com" reply_to="dana@example.com"/>
    </sender_identities>
    <register>plain, specific, second person; short sentences; no exclamation marks</register>
    <vocabulary_inversion>
      <pair never_write="dashboarding solution" write_instead="the Monday numbers"/>
      <pair never_write="leverage insights" write_instead="see what changed"/>
      <pair never_write="stakeholders" write_instead="whoever asks you for the numbers"/>
    </vocabulary_inversion>
    <forbidden_phrases>unlock, supercharge, game-changing, act now</forbidden_phrases>
    <derived_from>the product's in-app copy only; no customer interviews. Treat as a draft voice.</derived_from>
  </voice_module>

  <stack>
    <messaging_platform required="true" name="customerio" template_dialect="customerio" label="SUPPLIED"/>
    <analytics name="mixpanel" label="SUPPLIED"/>
    <cdp name="segment" label="SUPPLIED"/>
    <warehouse name="postgresql" sql_dialect="postgresql" label="SUPPLIED"/>
    <crm name="hubspot" label="SUPPLIED"/>
    <sms provider="" registration_status="not registered" label="SUPPLIED"/>
    <push sdk="customerio" platforms="ios, android" label="SUPPLIED"/>
    <connected_in_claude>Customer.io, Mixpanel, HubSpot</connected_in_claude>
  </stack>

  <data>
    <schemas>
      <table role="users" name="users" label="LIVE PULL"><![CDATA[user_id VARCHAR, email VARCHAR, created_at TIMESTAMP, country VARCHAR, plan VARCHAR, lifecycle_stage VARCHAR, email_consent_at TIMESTAMP, sms_consent_at TIMESTAMP]]></table>
      <table role="orders" name="orders" label="LIVE PULL"><![CDATA[order_id VARCHAR, user_id VARCHAR, order_at TIMESTAMP, status VARCHAR, gross_amount NUMERIC(18,2), discount_amount NUMERIC(18,2), net_amount NUMERIC(18,2), currency VARCHAR(3)]]></table>
      <table role="track_events" name="track_events" label="LIVE PULL"><![CDATA[event_id VARCHAR, user_id VARCHAR, anonymous_id VARCHAR, event_name VARCHAR, event_at TIMESTAMP, properties JSON]]></table>
    </schemas>
    <fill_rates observed_at="2026-10-19" label="LIVE PULL">
      <field name="users.email" rate="1.00"/>
      <field name="users.plan" rate="0.83"/>
      <field name="users.email_consent_at" rate="0.86"/>
      <field name="users.sms_consent_at" rate="0.22"/>
      <field name="users.lifecycle_stage" rate="0.00"/>
    </fill_rates>
    <tracking_plan ref="modules/02_behavioral_triggers_and_flows/schemas/custom_event_definitions.json" label="SUPPLIED"/>
    <consent>
      <channel name="email" field="users.email_consent_at" fill_rate="0.86" mechanism="single opt-in at signup" label="LIVE PULL"/>
      <channel name="sms" field="users.sms_consent_at" fill_rate="0.22" mechanism="web form checkbox" label="LIVE PULL"/>
      <channel name="push" field="" fill_rate="" mechanism="OS permission" label=""/>
    </consent>
    <identity_resolution label="SUPPLIED">user_id is primary; anonymous_id is stitched on signed_up; email is never the key</identity_resolution>
  </data>

  <deliverability>
    <sending_domains label="SUPPLIED">example.com</sending_domains>
    <sending_inventory label="SUPPLIED">Customer.io (selector nf1), HubSpot (selector hs1), billing system (unknown selector)</sending_inventory>
    <dns_records observed_at="" label="SUPPLIED"><![CDATA[_dmarc.example.com TXT "v=DMARC1; p=none; rua=mailto:dmarc-reports@example.com"]]></dns_records>
    <gate verdict="GREEN" assessed_at="2026-10-19" label="SUPPLIED"/>
    <volume daily_total="9000" daily_to_gmail="5200" daily_to_microsoft_consumer="900" label="ESTIMATE"/>
    <engagement_tiers engaged_30d="40000" engaged_90d="70000" engaged_180d="90000" unengaged="400000" observed_at="" label="SUPPLIED"/>
  </deliverability>

  <benchmarks>
    <metric name="activated within 9 days" value="0.280" period="mature signups as of 2026-10-19" bot_excluded="n/a" attribution_model="none" attribution_window_days="" label="LIVE PULL"/>
    <metric name="email click rate, lifecycle flows" value="0.031" period="last 90 days" bot_excluded="true" attribution_model="last click" attribution_window_days="5" label="SUPPLIED"/>
  </benchmarks>

  <program>
    <phase label="ESTIMATE">BUILD</phase>
    <flows>
      <flow name="Welcome" platform_id="" entry_volume_30d="3000" holdout_percent="0" status="live, no holdout" label="SUPPLIED"/>
    </flows>
    <tests_running>none</tests_running>
    <change_budget>up to three substantive changes a month</change_budget>
  </program>

  <constraints>
    <frequency_cap>1 lifecycle email a day and 3 a week across all flows; 1 in-app modal per session</frequency_cap>
    <quiet_hours>email and push 08:00 to 20:00 recipient local; no SMS until 10DLC registration is approved</quiet_hours>
    <approvals>founder approves any message from a named person</approvals>
    <do_not_contact>customers with an open support escalation</do_not_contact>
  </constraints>

  <environment>
    <tools_available label="LIVE PULL" observed_at="2026-10-19">true</tools_available>
  </environment>

  <task>
    <request>Design the activation flow for new signups.</request>
    <definition_of_done>a buildable spec in Customer.io, copy for every email step, and a holdout that can read inside a quarter</definition_of_done>
  </task>

</lmm_context>
